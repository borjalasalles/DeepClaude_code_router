# === Tier 1: DeepSeek native (China-hosted, cheapest) ===
# ONLY for queries the PII scanner AND publicness classifier both clear.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_FLASH=deepseek-chat       # V4 Flash
DEEPSEEK_MODEL_PRO=deepseek-reasoner     # V4 Pro

# Kill-switch: when 1, all tier-1 traffic collapses to tier 2 (Nebius).
# Default 0 (tier 1 active). Flip to 1 if classifier under audit.
DEEP_DEVOPS_DISABLE_PUBLIC_TIER=0

# === Tier 2: DeepSeek V4 via Nebius Token Factory (Amsterdam, EU/GDPR) ===
# Sign up: https://nebius.com/token-factory  (create an API key in the console)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_FLASH=deepseek-ai/DeepSeek-V4-Flash
NEBIUS_MODEL_PRO=deepseek-ai/DeepSeek-V4-Pro

# === Tier 3: Anthropic direct (confidential + escalation) ===
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_CAPABLE=claude-sonnet-4-6

# === Optional alternatives (M1+; not enabled by default) ===
# SCALEWAY_API_KEY=
# SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
# OPENROUTER_API_KEY=

# === Observability (M3) ===
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=deep-devops
